<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1a1a2e">

    <!-- Display -->
    <TextView
        android:id="@+id/tv_display"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:text="0"
        android:textColor="#FFFFFF"
        android:textSize="52sp"
        android:gravity="end|bottom"
        android:padding="16dp"
        android:background="#16213e"
        android:ellipsize="start"
        android:singleLine="true" />

    <!-- Buttons Grid -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="5"
        android:columnCount="4"
        android:rowCount="6"
        android:padding="4dp"
        android:background="#0f3460">

        <!-- Row 1: AC, +/-, %, ÷ -->
        <Button android:id="@+id/btn_clear" android:text="AC" style="@style/CalcButtonLight" android:layout_columnWeight="1" android:layout_rowWeight="1" />
        <Button android:id="@+id/btn_plus_minus" android:text="+/-" style="@style/CalcButtonLight" android:layout_columnWeight="1" android:layout_rowWeight="1" />
        <Button android:id="@+id/btn_percent" android:text="%" style="@style/CalcButtonLight" android:layout_columnWeight="1" android:layout_rowWeight="1" />
        <Button android:id="@+id/btn_divide" android:text="÷" style="@style/CalcButtonOrange" android:layout_columnWeight="1" android:layout_rowWeight="1" />

        <!-- Row 2: 7 8 9 × -->
        <Button android:id="@+id/btn_7" android:text="7" style="@style/CalcButtonDark" android:layout_columnWeight="1" android:layout_rowWeight="1" />
        <Button android:id="@+id/btn_8" android:text="8" style="@style/CalcButtonDark" android:layout_columnWeight="1" android:layout_rowWeight="1" />
        <Button android:id="@+id/btn_9" android:text="9" style="@style/CalcButtonDark" android:layout_columnWeight="1" android:layout_rowWeight="1" />
        <Button android:id="@+id/btn_multiply" android:text="×" style="@style/CalcButtonOrange" android:layout_columnWeight="1" android:layout_rowWeight="1" />

        <!-- Row 3: 4 5 6 - -->
        <Button android:id="@+id/btn_4" android:text="4" style="@style/CalcButtonDark" android:layout_columnWeight="1" android:layout_rowWeight="1" />
        <Button android:id="@+id/btn_5" android:text="5" style="@style/CalcButtonDark" android:layout_columnWeight="1" android:layout_rowWeight="1" />
        <Button android:id="@+id/btn_6" android:text="6" style="@style/CalcButtonDark" android:layout_columnWeight="1" android:layout_rowWeight="1" />
        <Button android:id="@+id/btn_minus" android:text="-" style="@style/CalcButtonOrange" android:layout_columnWeight="1" android:layout_rowWeight="1" />

        <!-- Row 4: 1 2 3 + -->
        <Button android:id="@+id/btn_1" android:text="1" style="@style/CalcButtonDark" android:layout_columnWeight="1" android:layout_rowWeight="1" />
        <Button android:id="@+id/btn_2" android:text="2" style="@style/CalcButtonDark" android:layout_columnWeight="1" android:layout_rowWeight="1" />
        <Button android:id="@+id/btn_3" android:text="3" style="@style/CalcButtonDark" android:layout_columnWeight="1" android:layout_rowWeight="1" />
        <Button android:id="@+id/btn_plus" android:text="+" style="@style/CalcButtonOrange" android:layout_columnWeight="1" android:layout_rowWeight="1" />

        <!-- Row 5: 0 . = -->
        <Button android:id="@+id/btn_0" android:text="0" style="@style/CalcButtonDark"
            android:layout_columnSpan="2" android:layout_columnWeight="2" android:layout_rowWeight="1" />
        <Button android:id="@+id/btn_dot" android:text="." style="@style/CalcButtonDark" android:layout_columnWeight="1" android:layout_rowWeight="1" />
        <Button android:id="@+id/btn_equals" android:text="=" style="@style/CalcButtonOrange" android:layout_columnWeight="1" android:layout_rowWeight="1" />

        <!-- Footer -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnSpan="4"
            android:layout_columnWeight="4"
            android:text="Made by Yogesh"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:gravity="center"
            android:textSize="12sp"
            android:padding="8dp" />

    </GridLayout>

</LinearLayout>
