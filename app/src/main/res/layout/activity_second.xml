<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/dashboard_bg"
    android:padding="16dp"
    android:gravity="center">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔢 Second Activity"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="@color/p4_color"
        android:padding="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="You have navigated to the Second Activity!\nYou can go further or go back."
        android:textSize="15sp"
        android:textColor="@color/text_secondary"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btn_to_third"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Go to Third Activity →"
        android:backgroundTint="@color/p4_color"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btn_back_first"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="← Back to First Activity"
        android:backgroundTint="@color/text_secondary" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Made by Yogesh"
        android:textColor="@color/colorPrimary"
        android:textSize="13sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="24dp" />

</LinearLayout>
