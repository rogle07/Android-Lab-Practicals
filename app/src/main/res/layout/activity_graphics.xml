<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/dashboard_bg">

    <com.yogesh.androidlabpracticals.practical8.DrawingView
        android:id="@+id/drawing_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="@android:color/white">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎨 Shapes: Circle, Rectangle, Line, Triangle"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button android:id="@+id/btn_rotate"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Rotate"
                android:textSize="11sp" android:backgroundTint="@color/p8_color"
                android:layout_marginEnd="2dp" />
            <Button android:id="@+id/btn_scale"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Scale"
                android:textSize="11sp" android:backgroundTint="@color/p4_color"
                android:layout_marginEnd="2dp" />
            <Button android:id="@+id/btn_translate"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Translate"
                android:textSize="11sp" android:backgroundTint="@color/p9_color"
                android:layout_marginEnd="2dp" />
            <Button android:id="@+id/btn_fade"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Fade"
                android:textSize="11sp" android:backgroundTint="@color/p7_color"
                android:layout_marginEnd="2dp" />
            <Button android:id="@+id/btn_reset"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Reset"
                android:textSize="11sp" android:backgroundTint="@color/text_secondary" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Made by Yogesh"
            android:textColor="@color/colorPrimary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="8dp" />

    </LinearLayout>
</LinearLayout>
